# 市场索引器环境变量示例：复制为 market-indexer/.env。
# 网络与市场、回购池地址须匹配；切换链时使用独立索引库或 schema，并重启索引器。

# 网络名称：bsc 为 BSC 主网，bscTestnet 为测试网，anvil 为本地链；各项目必须选择同一网络。
CHAIN_NETWORK=anvil

# 可选：覆盖网络预设的 HTTP RPC；不配置时使用 Viem 预设地址，本地默认 http://127.0.0.1:8545。
# CHAIN_RPC_URL=https://your-rpc.example

# 可选：索引器使用的 WebSocket RPC；不配置也可仅使用 HTTP RPC。
# CHAIN_WS_URL=wss://your-websocket.example

# 索引器监听的 TokenExchange 市场合约地址，须与 server/web 的市场地址一致。
TOKEN_EXCHANGE_ADDRESS=0xa63b4b1752da3cf4ace1120ffd92212163494546

# 开始索引的区块号，填写本次市场合约的部署区块；导出部署信息时会自动回填。
START_BLOCK=59

# 必填：Ponder 数据库 schema 名称；启动入口会从实际 .env 提前加载，不同链或环境使用独立 schema。
DATABASE_SCHEMA=market_indexer

# 索引器专用 PostgreSQL 连接串，格式为 postgresql://用户名:密码@主机:端口/数据库。
DATABASE_URL=postgresql://user:password@localhost:5432/market_indexer

# BuybackPool 回购池合约地址；后台从此合约继续读取代币、Owner 和分红 Vault 等信息。
BUYBACK_POOL_ADDRESS=0x1f4a59088f543d504ebb8a764b8fc47909abcb3a

# 必填：后端与索引器内部接口的共享鉴权密钥，两边填写同一随机值，不配置到 web/admin-web。
MARKET_INDEXER_INTERNAL_API_KEY=
