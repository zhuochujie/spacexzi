# 用户前端环境变量示例：复制为 web/.env，修改后重新构建前端。
# VITE_ 配置会进入浏览器构建产物，只填写公开配置；合约地址与后端保持一致。

# 网络名称：bsc 为 BSC 主网，bscTestnet 为测试网，anvil 为本地链；各项目必须选择同一网络。
VITE_CHAIN_NETWORK=anvil

# 可选：覆盖网络预设的 HTTP RPC；不配置时使用 Viem 预设地址，本地默认 http://127.0.0.1:8545。
# VITE_CHAIN_RPC_URL=https://your-rpc.example

# 用户业务 API 地址前缀或完整地址；使用 /api 时需通过前端代理或反向代理转发。
VITE_API_BASE_URL=/api

# 市场索引查询 API 地址前缀或完整地址；使用 /market-api 时需配置相应代理。
VITE_MARKET_API_BASE_URL=/market-api

# TokenExchange 市场合约地址，必须来自当前所选网络的同一批部署。
VITE_MARKET_CONTRACT_ADDRESS=0x8ccbe19e698372d1dbe6c07dd41c75bbf13f405d

# Mining 矿机及收益资金合约地址，必须与前后端使用的部署一致。
VITE_MINING_CONTRACT_ADDRESS=0xcd4627715c9313af30524125e157788273103a89

# NodeMembership 节点合约地址，使用当前支持后端 nonce 签名的版本。
VITE_NODE_CONTRACT_ADDRESS=0xd259a528a8956e278d33d37ce12967229e43b1dc

# SPACE 代币合约地址，使用当前部署的 SpaceXZIToken，精度为 18 位。
VITE_SPACE_TOKEN_ADDRESS=0x99624061e9b289389e518031da1a0cc248b30a46

# USDT 的 ERC20 合约地址，必须在目标链已部署且精度为 18 位；本地链需先部署测试代币。
VITE_USDT_TOKEN_ADDRESS=0xfe3a32ffb8f4df5c687c740716a7a114b8a87561

# 节点分红 Vault 合约地址，不是节点购买款的 NODE_TREASURY_ADDRESS。
VITE_NODE_FEE_VAULT_ADDRESS=0x3895302a1d0b27b52e6dd4949158531417878914

# VIP 分红 Vault 合约地址。
VITE_VIP_FEE_VAULT_ADDRESS=0x22f1aa22eb80395e3539027c510acfcfabeb1c03

# BuybackPool 回购池合约地址；后台从此合约继续读取代币、Owner 和分红 Vault 等信息。
VITE_BUYBACK_POOL_ADDRESS=0xb4a5881b43e76ead784ba533480d2341dfad12e1

# 回购 USDT 分红 Vault 合约地址，保存回购买入资金中的 50% 分红部分。
VITE_BUYBACK_DIVIDEND_VAULT_ADDRESS=0x796e4f9eb1dede031e8e9ed7ee23c588317fa65d
