# 后端环境变量示例：复制为 server/.env，用户 API、后台 API 和 Worker 使用一致的环境。
# 合约地址、网络名和索引服务必须对应同一环境；部署导出脚本可回填公开合约配置。

# 网络名称：bsc 为 BSC 主网，bscTestnet 为测试网，anvil 为本地链；各项目必须选择同一网络。
CHAIN_NETWORK=anvil

# 可选：覆盖网络预设的 HTTP RPC；不配置时使用 Viem 预设地址，本地默认 http://127.0.0.1:8545。
# CHAIN_RPC_URL=https://your-rpc.example

# 必填：后端业务 PostgreSQL 数据库主机地址。
DB_HOST=127.0.0.1

# 必填：PostgreSQL 端口，通常为 5432。
DB_PORT=5432

# 必填：业务数据库登录用户名。
DB_USERNAME=postgres

# 必填：业务数据库登录密码。
DB_PASSWORD=change-me

# 必填：业务数据库名称；不同链或环境应使用独立数据库。
DB_DATABASE=mining

# 是否由 TypeORM 自动同步表结构：生产环境使用 false，并按项目 SQL 脚本初始化或迁移。
TYPEORM_SYNCHRONIZE=false

# 用户 API 服务监听端口，需要与用户前端代理目标保持一致。
USER_API_PORT=3000

# 管理员 API 服务监听端口，需要与后台前端代理目标保持一致。
ADMIN_API_PORT=3001

# 必填：Redis 主机，用于缓存、任务队列、维护状态等；同一环境的 API 与 Worker 使用同一配置。
REDIS_HOST=localhost

# 必填：Redis 端口，通常为 6379。
REDIS_PORT=6379

# 可选：Redis 密码；Redis 未启用密码时留空。
REDIS_PASSWORD=

# 必填：API 登录令牌的签名密钥；同一环境内使用一致的值，不是钱包私钥。
JWT_SECRET=change-me

# 登录令牌有效期，例如 3600s 表示 1 小时。
JWT_EXPIRES_IN=3600s

# 可选：首次初始化的后台管理员用户名；必须与 ADMIN_PASSWORD 同时填写，已有同名账号不会覆盖。
ADMIN_USERNAME=

# 可选：初始管理员密码，至少 8 位；两项都留空时不创建账号，修改此处不会重置已有密码。
ADMIN_PASSWORD=

# 可选：Telegram 通知机器人令牌；与 TELEGRAM_CHAT_ID 配合使用，不需要通知时留空。
TELEGRAM_BOT_TOKEN=

# 可选：接收后台操作及任务通知的 Telegram 会话 ID；不需要通知时留空。
TELEGRAM_CHAT_ID=

# TokenExchange 市场合约地址，必须来自当前所选网络的同一批部署。
MARKET_CONTRACT_ADDRESS=0x8ccbe19e698372d1dbe6c07dd41c75bbf13f405d

# Mining 矿机及收益资金合约地址，必须与前后端使用的部署一致。
MINING_CONTRACT_ADDRESS=0xcd4627715c9313af30524125e157788273103a89

# NodeMembership 节点合约地址，使用当前支持后端 nonce 签名的版本。
NODE_CONTRACT_ADDRESS=0xd259a528a8956e278d33d37ce12967229e43b1dc

# SPACE 代币合约地址，使用当前部署的 SpaceXZIToken，精度为 18 位。
SPACE_TOKEN_ADDRESS=0x99624061e9b289389e518031da1a0cc248b30a46

# USDT 的 ERC20 合约地址，必须在目标链已部署且精度为 18 位；本地链需先部署测试代币。
USDT_TOKEN_ADDRESS=0xfe3a32ffb8f4df5c687c740716a7a114b8a87561

# 节点分红 Vault 合约地址，不是节点购买款的 NODE_TREASURY_ADDRESS。
NODE_FEE_VAULT_ADDRESS=0x3895302a1d0b27b52e6dd4949158531417878914

# VIP 分红 Vault 合约地址。
VIP_FEE_VAULT_ADDRESS=0x22f1aa22eb80395e3539027c510acfcfabeb1c03

# 必填：后端业务签名钱包私钥，公开地址必须与部署时的 SIGNER_ADDRESS 一致；不是后台登录密码。
SIGNER_PRIVATE_KEY=

# BuybackPool 回购池合约地址；后台从此合约继续读取代币、Owner 和分红 Vault 等信息。
BUYBACK_POOL_ADDRESS=0xb4a5881b43e76ead784ba533480d2341dfad12e1

# 回购 USDT 分红 Vault 合约地址，保存回购买入资金中的 50% 分红部分。
BUYBACK_DIVIDEND_VAULT_ADDRESS=0x796e4f9eb1dede031e8e9ed7ee23c588317fa65d

# 必填：后端访问 market-indexer 的 HTTP API 地址，使用后端实际可访问的地址。
MARKET_INDEXER_API_URL=http://127.0.0.1:42069

# 必填：后端与索引器内部接口的共享鉴权密钥，两边填写同一随机值，不配置到 web/admin-web。
MARKET_INDEXER_INTERNAL_API_KEY=
