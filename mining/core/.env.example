# 合约部署环境变量示例：复制为 core/.env 后按目标网络填写。
# 金额统一使用 18 位最小单位：1 枚 = 1000000000000000000；手续费比例使用 BP：10000 = 100%。
# 示例中的钱包及合约地址可能来自本地测试，必须核对目标网络；部署导出脚本不会更新此文件。

# 网络名称：bsc 为 BSC 主网，bscTestnet 为测试网，anvil 为本地链；各项目必须选择同一网络。
CHAIN_NETWORK=anvil

# 可选：覆盖网络预设的 HTTP RPC；不配置时使用 Viem 预设地址，本地默认 http://127.0.0.1:8545。
# CHAIN_RPC_URL=https://your-rpc.example

# 必填：部署钱包私钥；该钱包需有目标网络的原生币支付部署 Gas。
PRIVATE_KEY=

# 必填：后端签名钱包的公开地址；必须对应 server 中的 SIGNER_PRIVATE_KEY，供矿机、市场和节点合约验签。
SIGNER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# 必填：市场费用接收地址，同时作为代币转账市场税的接收地址。
MARKET_FEE_RECEIVER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# USDT 的 ERC20 合约地址，必须在目标链已部署且精度为 18 位；本地链需先部署测试代币。
USDT_TOKEN_ADDRESS=0xfe3a32ffb8f4df5c687c740716a7a114b8a87561

# 必填：节点购买及升级款的项目金库地址，接收扣除推荐奖励后的资金。
NODE_TREASURY_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# 可选：部署后所有合约的 Owner 地址；不配置时使用部署钱包，填写后会转交管理权限。
OWNER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# 可选：节点 USDT 分红手续费接收地址；不配置时使用 MARKET_FEE_RECEIVER_ADDRESS。
USDT_FEE_RECEIVER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# 市场允许的最低挂单价格：每枚 SPACE 对应的 USDT，按 18 位精度填写。
MARKET_MIN_PRICE_WEI=500000000000000000

# 市场允许的最高挂单价格：每枚 SPACE 对应的 USDT，须不低于最低价。
MARKET_MAX_PRICE_WEI=600000000000000000

# 市场最小订单数量，单位为 SPACE 最小单位；1000000000000000000 表示 1 SPACE。
MARKET_MIN_ORDER_SPACE_WEI=1000000000000000000

# 市场交易分配给节点的手续费比例，单位 BP；500 表示 5%，10000 表示 100%。
MARKET_NODE_FEE_BP=500

# 市场交易分配给市场收款地址的手续费比例，单位 BP；与节点手续费之和不能超过 10000。
MARKET_MARKER_FEE_BP=500

# 每台免费矿机的累计产出拨备上限，单位为 SPACE 最小单位；部署后为合约构造参数。
FREE_MINER_SPACE_AMOUNT_WEI=50000000000000000000

# 交易商向回购池买入 SPACE 的固定单价，按 USDT 的 18 位精度填写；必须大于卖出价。
BUYBACK_BUY_PRICE_WEI=400000000000000000

# 用户向回购池卖出 SPACE 的固定单价，按 USDT 的 18 位精度填写；必须大于 0。
BUYBACK_SELL_PRICE_WEI=100000000000000000

# 必填：接收回购买入 USDT 中 20% 份额的固定地址，部署后不可通过现有接口修改。
BUYBACK_FIXED_RECEIVER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# 回购部署后的初始暂停状态：true 暂停买卖，false 开放买卖；Owner 后续可调整。
BUYBACK_PAUSED=false

# 部署时划入回购池的 SPACE 库存，来自发行总量；单位为 SPACE 最小单位。
INITIAL_BUYBACK_SPACE_WEI=2000000000000000000000000

# 部署时注入回购池的 USDT 储备，来自部署钱包；单位为 USDT 最小单位，0 表示不注入。
INITIAL_BUYBACK_USDT_WEI=0

# 仅单独部署节点合约时填写：推荐奖励将转入此已有 Mining 合约；完整部署脚本会自动使用新建 Mining。
# MINING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 节点合约的初始暂停状态：true 暂停购买和升级，false 开放；Owner 后续可调整。
NODE_PURCHASE_PAUSED=false

# 1 级节点名称，仅用于等级展示。
NODE_LEVEL_1_NAME=Starter

# 1 级节点完整价格，按 USDT 的 18 位精度填写；各等级价格必须递增。
NODE_LEVEL_1_PRICE_WEI=100000000000000000000

# 1 级节点是否开放购买或升级：true 开放，false 关闭。
NODE_LEVEL_1_ENABLED=true

# 2 级节点名称，仅用于等级展示。
NODE_LEVEL_2_NAME=Core

# 2 级节点完整价格，按 USDT 的 18 位精度填写；各等级价格必须递增。
NODE_LEVEL_2_PRICE_WEI=500000000000000000000

# 2 级节点是否开放购买或升级：true 开放，false 关闭。
NODE_LEVEL_2_ENABLED=true

# 3 级节点名称，仅用于等级展示。
NODE_LEVEL_3_NAME=Elite

# 3 级节点完整价格，按 USDT 的 18 位精度填写；各等级价格必须递增。
NODE_LEVEL_3_PRICE_WEI=1000000000000000000000

# 3 级节点是否开放购买或升级：true 开放，false 关闭。
NODE_LEVEL_3_ENABLED=true

# 4 级节点名称，仅用于等级展示。
NODE_LEVEL_4_NAME=Prime

# 4 级节点完整价格，按 USDT 的 18 位精度填写；各等级价格必须递增。
NODE_LEVEL_4_PRICE_WEI=2000000000000000000000

# 4 级节点是否开放购买或升级：true 开放，false 关闭。
NODE_LEVEL_4_ENABLED=true
